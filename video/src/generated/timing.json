      "frames": 386,
      "lines": [
        {
          "file": "audio/mcp-1.wav",
          "text": "And because agents trade too, Domino ships an MCP server.",
          "start": 0.4,
          "seconds": 4.399979166666666
        },
        {
          "file": "audio/mcp-2.wav",
